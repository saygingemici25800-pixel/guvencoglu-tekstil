{
  "redirects": [
    { "source": "/v2", "destination": "/", "permanent": true },
    { "source": "/v2/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/hikayemiz", "destination": "/", "permanent": true },
    { "source": "/hizmetler", "destination": "/ne-yapiyoruz", "permanent": true },
    { "source": "/uretim", "destination": "/ne-yapiyoruz", "permanent": true },
    { "source": "/referanslar", "destination": "/ne-yapiyoruz", "permanent": true },
    { "source": "/sektorler", "destination": "/ne-yapiyoruz", "permanent": true },
    { "source": "/ne-yapiyoruz/saglik", "destination": "/ne-yapiyoruz", "permanent": true },
    { "source": "/ne-yapiyoruz/otel", "destination": "/ne-yapiyoruz", "permanent": true },
    { "source": "/ne-yapiyoruz/okul", "destination": "/ne-yapiyoruz", "permanent": true },
    { "source": "/ne-yapiyoruz/restoran", "destination": "/ne-yapiyoruz", "permanent": true }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
